generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  PENDING
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTERED
  CANCELLED
}

model Job {
  id             String    @id @default(uuid())
  type           String
  status         JobStatus @default(PENDING)
  payload        Json
  result         Json?
  error          String?
  attempt        Int       @default(0)
  maxAttempts    Int       @default(3)
  idempotencyKey String?   @unique
  correlationId  String
  version        Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  startedAt      DateTime?
  completedAt    DateTime?

  @@map("jobs")
}

model OutboxEvent {
  id                 String    @id @default(uuid())
  aggregateId        String
  eventType          String
  topic              String
  messageKey         String
  payload            Json
  createdAt          DateTime  @default(now())
  publishedAt        DateTime?
  publishingAttempts Int       @default(0)
  lastError          String?

  // Prisma's schema DSL has no partial-index syntax; the real (WHERE
  // published_at IS NULL) index is hand-added as raw SQL in the migration —
  // this @@index only keeps `prisma migrate diff` from flagging it as drift.
  @@index([createdAt])
  @@map("outbox_events")
}
