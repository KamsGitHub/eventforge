{
  "name": "eventforge",
  "version": "0.1.0",
  "private": true,
  "description": "Kafka-based distributed job processing platform (modular monolith -> extracted services)",
  "license": "UNLICENSED",
  "engines": {
    "node": "^22 || ^24 || >=26"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "jest",
    "boundaries": "depcruise --config .dependency-cruiser.cjs src"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "pg": "^8.22.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "testcontainers": "^12.0.4",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  }
}
