# NODE_ENV/PORT/LOG_LEVEL are read by src/config/env.ts.
# DATABASE_URL is read by prisma.config.ts / src/db/prisma.ts (Milestone 4).
# KAFKA_BROKERS/KAFKA_CLIENT_ID are read by src/config/env.ts (Milestone 6), but no
# running code constructs a Kafka client from them yet — that starts at Milestone 9.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://eventforge:eventforge@localhost:5432/eventforge

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=eventforge
