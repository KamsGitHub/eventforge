# NODE_ENV/PORT/LOG_LEVEL are read by src/config/env.ts.
# DATABASE_URL is read by prisma.config.ts / src/db/prisma.ts (Milestone 4).
# KAFKA_BROKERS/KAFKA_CLIENT_ID are read by src/config/env.ts (Milestone 6) and used
# by server.ts to build the execution module's producer/consumer (Milestone 7).

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://eventforge:eventforge@localhost:5432/eventforge

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=eventforge
